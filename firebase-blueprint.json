{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profile synchronized with WordPress/WooCommerce customer ID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^(\\+234|0)?[789][01]\\d{8}$|^$"
        },
        "wooCustomerId": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "SavedAddress": {
      "title": "SavedAddress",
      "description": "Nigerian delivery address saved by the customer.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "phone": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^(\\+234|0)[789][01]\\d{8}$"
        },
        "street": {
          "type": "string",
          "minLength": 4,
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4
        },
        "isDefault": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "label", "firstName", "lastName", "phone", "street", "city", "state", "country", "isDefault", "createdAt", "updatedAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Saved product reference in a customer wishlist.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "addedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["productId", "addedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authoritative store administrator allowlist record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["administrator", "shop_manager"]
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "grantedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile document; strictly owner or admin read/write."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/SavedAddress" },
      "description": "Customer saved Nigerian shipping addresses."
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Customer saved wishlist product references."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Store administrator access control registry."
    }
  }
}
