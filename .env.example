# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- WordPress & WooCommerce Integration ---
# URL of your WordPress installation (e.g. https://store.zoramarket.ng)
WOOCOMMERCE_URL=""
# WooCommerce REST API v3 Keys (WooCommerce > Settings > Advanced > REST API)
WC_CONSUMER_KEY=""
WC_CONSUMER_SECRET=""
# Shared secret for the Zora Commerce Bridge WordPress plugin
WP_BRIDGE_SECRET=""

# --- Admin Access Control ---
# Comma-separated list of authorized administrator emails (verified Firebase Auth required)
ADMIN_EMAILS="aduragbemifagbemiro247@gmail.com"

# --- Payment Gateways (Server-Side Only — NEVER expose secret keys to client) ---
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# --- Rider Session Signing Secret (auto-generated if omitted) ---
RIDER_SESSION_SECRET=""

# --- Automated Customer Email Delivery (Optional — defaults to Admin Email Outbox in sandbox) ---
# Provide EITHER Resend OR SMTP credentials to dispatch live customer emails
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="orders@diamondmarket.ng"

